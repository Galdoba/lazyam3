#!/usr/bin/env python3
"""Execute the RPI wrap-up phase: extract ADRs, validate, archive.

Usage:
  wrap_up.py <cycle-name> [--dry-run] [--no-archive]

Arguments:
  cycle-name        Name of the RPI cycle (e.g. 'logger-debug-level')
  --dry-run         Show what would be done without making changes
  --no-archive      Extract and validate ADRs but skip archiving intermediate docs

Environment:
  ADR_DIR           Override default doc/adr/ directory (default: ./doc/adr)
"""

import argparse
import os
import re
import shutil
import sys
from datetime import date, datetime
from pathlib import Path

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML required. Install with: pip install pyyaml", file=sys.stderr)
    sys.exit(1)

# ── Paths ────────────────────────────────────────────────────────────
RPI_DIR = Path("rpi")
DOC_DIR = Path("doc")
ADR_DIR = None  # Set from env or default
SCRIPTS_DIR = Path(".agents/skills/rpi-wrap-up/scripts")


def get_adr_dir() -> Path:
    """Get the ADR directory, creating it if needed."""
    global ADR_DIR
    if ADR_DIR is None:
        ADR_DIR = os.environ.get("ADR_DIR", str(DOC_DIR / "adr"))
    ADR_DIR = Path(ADR_DIR)
    ADR_DIR.mkdir(parents=True, exist_ok=True)
    return ADR_DIR


def title_to_slug(title: str) -> str:
    """Convert a title to a kebab-case slug."""
    slug = title.lower().strip()
    slug = re.sub(r"[^a-z0-9\s-]", "", slug)
    slug = re.sub(r"\s+", "-", slug)
    slug = re.sub(r"-+", "-", slug)
    return slug.strip("-")


def next_adr_number(adr_dir: Path) -> int:
    """Find the next available ADR number."""
    max_num = 0
    if adr_dir.exists():
        for f in adr_dir.glob("*.md"):
            match = re.match(r"^(\d{4})-", f.stem)
            if match:
                num = int(match.group(1))
                if num > max_num:
                    max_num = num
    return max_num + 1


def parse_implementation_adrs(impl_path: Path) -> list[dict]:
    """Parse Architecture Decision Records from implementation.md."""
    content = impl_path.read_text(encoding="utf-8")

    # Find "## Architecture Decision Records" section
    adr_section_match = re.search(
        r"## Architecture Decision Records\s*\n([\s\S]*?)"
        r"(?:\n## |\Z)",
        content,
    )
    if not adr_section_match:
        return []

    adr_text = adr_section_match.group(1)

    # Split into individual ADRs by ### headings
    adr_blocks = re.split(r"\n### ", adr_text)
    adrs = []

    for block in adr_blocks:
        block = block.strip()
        if not block:
            continue

        # First line is the title (strip ### if present)
        lines = block.split("\n")
        title = lines[0].strip()
        if title.startswith("### "):
            title = title[4:].strip()

        body_text = "\n".join(lines[1:])

        # Extract fields (case-insensitive headers)
        fields = {}
        current_field = None
        field_lines = []

        for line in body_text.split("\n"):
            field_match = re.match(
                r"^(context|options|decision|rationale|consequences):\s*$",
                line.strip().lower(),
            )
            if field_match:
                # Save previous field
                if current_field:
                    fields[current_field] = "\n".join(field_lines).strip()
                current_field = field_match.group(1)
                field_lines = []
            elif current_field:
                field_lines.append(line)

        if current_field:
            fields[current_field] = "\n".join(field_lines).strip()

        # Map fields to body sections
        body_sections = {}
        field_map = {
            "context": "## Context",
            "decision": "## Decision",
            "rationale": "## Rationale",
            "consequences": "## Consequences",
            "options": "## Options",
        }

        for field_name, section_header in field_map.items():
            if field_name in fields and fields[field_name]:
                content_lines = fields[field_name].split("\n")
                # Keep bullet prefix for consequences/options (validator expects it)
                if field_name in ("consequences", "options"):
                    content_lines = [
                        l[2:] if l.startswith("- ") else l for l in content_lines
                    ]
                    # Re-add bullet prefix for output
                    content_lines = ["- " + l for l in content_lines if l.strip()]
                body_sections[section_header] = "\n".join(content_lines)

        adrs.append({
            "title": title,
            "fields": fields,
            "body_sections": body_sections,
        })

    return adrs


def determine_scope(adr: dict) -> str:
    """Estimate the scope of a decision based on affected packages mentioned in the ADR."""
    all_text = " ".join(adr["body_sections"].values())
    # Count unique package references in the decision text
    package_refs = set()
    known_packages = {
        "fso", "pipeline", "ingest", "metadata", "script", "config",
        "logging", "jsonstore", "commands", "callname",
    }
    for word in known_packages:
        if word in all_text.lower():
            package_refs.add(word)
    if len(package_refs) >= 2:
        return "cross-package"
    return "single-package"  # Will fail validation - signals manual review needed


def generate_adr_file(adr: dict, adr_num: int, adr_dir: Path) -> Path:
    """Generate a validated ADR file."""
    title = adr["title"]
    slug = title_to_slug(title)
    filename = f"{adr_num:04d}-{slug}.md"
    filepath = adr_dir / filename

    # Build description from decision field
    decision_text = adr["body_sections"].get("## Decision", "")
    # Take first sentence as description
    sentences = decision_text.split(". ")
    description = sentences[0] if sentences else title
    if description and not description.endswith("."):
        description += "."

    # Determine scope from affected packages
    scope = determine_scope(adr)

    # Build body
    body_parts = []
    for section in ["## Context", "## Decision", "## Rationale", "## Consequences"]:
        if section in adr["body_sections"]:
            body_parts.append(f"{section}\n\n{adr['body_sections'][section]}")

    if "## Options" in adr["body_sections"]:
        body_parts.append(f"\n## Options\n\n{adr['body_sections']['## Options']}")

    body = "\n\n".join(body_parts)

    # Write file
    content = f"""---
id: "{filename.replace('.md', '')}"
title: "{title}"
description: "{description}"
status: accepted
date: "{date.today().isoformat()}"
scope: {scope}
---

# {title}

{body}
""".lstrip()

    filepath.write_text(content, encoding="utf-8")
    return filepath


def archive_cycle_docs(cycle_name: str, dry_run: bool):
    """Archive intermediate documents for a cycle."""
    cycle_dir = RPI_DIR / cycle_name
    archive_dir = RPI_DIR / "archive" / cycle_name

    if not cycle_dir.exists():
        print(f"WARNING: {cycle_dir} does not exist, skipping archive")
        return

    docs_to_archive = ["research.md", "plan.md", "implementation.md"]
    existing_docs = [d for d in docs_to_archive if (cycle_dir / d).exists()]

    if not existing_docs:
        print(f"INFO: No documents to archive in {cycle_dir}")
        return

    if dry_run:
        print(f"DRY-RUN: Would archive {len(existing_docs)} docs to {archive_dir}")
        for doc in existing_docs:
            print(f"  {cycle_dir}/{doc} → {archive_dir}/{doc}")
        return

    archive_dir.mkdir(parents=True, exist_ok=True)

    for doc in existing_docs:
        src = cycle_dir / doc
        dst = archive_dir / doc
        shutil.move(str(src), str(dst))
        print(f"  Archived: {src} → {dst}")

    # Remove empty cycle directory
    remaining = [f for f in cycle_dir.iterdir() if f.is_file()]
    if not remaining:
        cycle_dir.rmdir()
        print(f"  Removed empty directory: {cycle_dir}")


def generate_index(adr_dir: Path, dry_run: bool):
    """Generate INDEX.md for the ADR directory."""
    index_path = adr_dir / "INDEX.md"

    adr_files = sorted(adr_dir.glob("*.md"))
    if not adr_files:
        if dry_run:
            print("DRY-RUN: INDEX.md would be created (no ADRs yet)")
        return

    rows = []
    for adr_file in adr_files:
        content = adr_file.read_text(encoding="utf-8")
        fm_match = re.search(r"---\n(.*?)\n---", content, re.DOTALL)
        if not fm_match:
            continue
        try:
            fm = yaml.safe_load(fm_match.group(1)) or {}
        except yaml.YAMLError:
            continue

        adr_id = fm.get("id", adr_file.stem)
        title = fm.get("title", adr_file.stem)
        status = fm.get("status", "unknown")
        date_val = fm.get("date", "unknown")
        scope_val = fm.get("scope", "-")

        rows.append(f"| {adr_id} | {title} | {status} | {date_val} | {scope_val} |")

    header = """# Architecture Decision Records

| ID | Title | Status | Date | Scope |
|----|-------|--------|------|-------|

"""
    index_content = header + "\n".join(rows) + "\n"

    if dry_run:
        print(f"DRY-RUN: INDEX.md would be updated at {index_path}")
        return

    index_path.write_text(index_content, encoding="utf-8")
    print(f"  Updated: {index_path}")


def main():
    parser = argparse.ArgumentParser(description="RPI Wrap-Up: extract ADRs, validate, archive")
    parser.add_argument("cycle_name", help="Name of the RPI cycle (e.g. logger-debug-level)")
    parser.add_argument("--dry-run", action="store_true", help="Show what would be done")
    parser.add_argument("--no-archive", action="store_true", help="Skip archiving intermediate docs")
    args = parser.parse_args()

    cycle_name = args.cycle_name
    impl_path = RPI_DIR / cycle_name / "implementation.md"

    if not impl_path.exists():
        print(f"ERROR: {impl_path} not found. Run rpi-implement first.", file=sys.stderr)
        sys.exit(1)

    adr_dir = get_adr_dir()
    adr_num = next_adr_number(adr_dir)

    print(f"RPI Wrap-Up: {cycle_name}")
    print(f"  ADR directory: {adr_dir}")
    print(f"  Starting ADR number: {adr_num:04d}")
    print()

    # Step 1: Extract ADRs
    print("Step 1: Extracting ADRs from implementation.md...")
    adrs = parse_implementation_adrs(impl_path)

    if not adrs:
        print("  No ADRs found in implementation.md. Nothing to do.")
        if not args.no_archive:
            archive_cycle_docs(cycle_name, args.dry_run)
        return

    print(f"  Found {len(adrs)} ADR(s):")
    for adr in adrs:
        print(f"    - {adr['title']}")
    print()

    # Step 2: Generate ADR files
    print("Step 2: Generating ADR files...")
    generated_files = []
    for adr in adrs:
        filepath = generate_adr_file(adr, adr_num, adr_dir)
        generated_files.append(filepath)
        print(f"  Created: {filepath}")
        adr_num += 1
    print()

    # Step 3: Validate ADRs
    print("Step 3: Validating ADRs...")
    validate_script = SCRIPTS_DIR / "validate_adr.py"
    if not validate_script.exists():
        print(f"  ERROR: Validation script not found: {validate_script}", file=sys.stderr)
        sys.exit(1)

    # Validate all ADRs together (includes cross-reference check)
    cmd = f'python3 "{validate_script}" --all "{adr_dir}"'
    if args.dry_run:
        print(f"  DRY-RUN: {cmd}")
    else:
        import subprocess
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        print(f"  {result.stdout.strip()}")
        if result.returncode != 0:
            print(f"  {result.stderr.strip()}", file=sys.stderr)
            print("  ERROR: Validation failed. Fix ADRs and re-run.", file=sys.stderr)
            sys.exit(1)
    print()

    # Step 4: Generate INDEX.md
    print("Step 4: Generating INDEX.md...")
    generate_index(adr_dir, args.dry_run)
    print()

    # Step 5: Archive intermediate docs
    if not args.no_archive:
        print("Step 5: Archiving intermediate documents...")
        archive_cycle_docs(cycle_name, args.dry_run)
        print()

    print("Wrap-up complete.")


if __name__ == "__main__":
    main()
